{
  "name": "@nova/database",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Database tier — Drizzle ORM schema + Neon PostgreSQL connection + migrations",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.38.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2"
  }
}
