# ============================================================
# BACKEND TIER ENV — server config + AI API keys
# Copy from .env.example and fill in your real values.
# Used by: the Express API server.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- CORS (comma-separated or * for any origin) ---
CORS_ORIGIN="http://localhost:5173"

# --- AI Provider ---
# Which AI gateway to use: openrouter (default) or openai
AI_PROVIDER=openrouter

# --- OpenRouter API ---
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
# Model id to route to (any model listed on openrouter.ai/models).
# Example free model:
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
# Optional: attribution headers OpenRouter uses to credit your app
# SITE_URL="https://your-site.com"

# --- Legacy OpenAI (only used when AI_PROVIDER=openai) ---
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# --- Database ---
# DATABASE_URL is loaded automatically from ../database/.env
# You can override it here for deployment:
# DATABASE_URL="postgresql://..."